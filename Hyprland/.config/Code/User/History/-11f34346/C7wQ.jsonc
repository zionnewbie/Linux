// -*- mode: jsonc -*-
{
    "layer": "top",
    // "position": "top",
    // "height": 30,
    // "spacing": 4,
    "position": "top",
    "height": 42,
    "spacing": 10,
    // ─────────────────────────────────────────────
    // Module layout
    // ─────────────────────────────────────────────
    "modules-left": [
        "clock",
        "hyprland/workspaces",
        "hyprland/submap",
        "custom/media"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "tray",
        "pulseaudio",
        "group/sysinfo",
        "group/controls",
        "group/Connect",
        "keyboard-state",
        "idle_inhibitor",
        "battery",
        "custom/power"
    ],
    // ─────────────────────────────────────────────
    // Hyprland
    // ─────────────────────────────────────────────
    "hyprland/workspaces": {
        "format": "{name}: {icon}",
        "format-icons": {
            "active": "",
            "default": ""
        }
    },
    "hyprland/submap": {
        "format": "{submap}",
        "max-length": 8,
        "tooltip": false
    },
    "hyprland/window": {
        "format": "{}",
        "max-length": 100,
        "rewrite": {
            "(.*) - Mozilla Firefox": "🌎 $1",
            "(.*) - zsh": "> [$1]"
        }
    },
    // ─────────────────────────────────────────────
    // Keyboard
    // ─────────────────────────────────────────────
    "keyboard-state": {
        "numlock": true,
        "capslock": true,
        "format": "{name} {icon}",
        "format-icons": {
            "locked": "",
            "unlocked": ""
        }
    },
    // ─────────────────────────────────────────────
    // Media / MPD
    // ─────────────────────────────────────────────
    "custom/media": {
        "format": "{icon} {text}",
        "return-type": "json",
        "max-length": 40,
        "format-icons": {
            "spotify": "",
            "default": "🎜"
        },
        "escape": true,
        "exec": "$HOME/.config/waybar/mediaplayer.py 2> /dev/null"
    },
    // ─────────────────────────────────────────────
    // Idle inhibitor
    // ─────────────────────────────────────────────
    "idle_inhibitor": {
        "format": "{icon}",
        "tooltip": false,
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    // ─────────────────────────────────────────────
    // System information
    // ─────────────────────────────────────────────
    "cpu": {
        "interval": 2,
        "format": "{usage}% ",
        "tooltip": false
    },
    "memory": {
        "interval": 5,
        "format": "{}% "
    },
    "disk": {
        "interval": 30,
        "paths": [
            "/"
        ],
        "format": "{specific_free:0.2f} / {specific_total:0.2f} GB",
        "unit": "GB"
    },
    "temperature": {
        "interval": 5,
        "critical-threshold": 80,
        "format": "{temperatureC}°C {icon}",
        "format-icons": [
            "󰉬",
            "",
            "󰉪"
        ]
    },
    // ─────────────────────────────────────────────
    // Battery
    // ─────────────────────────────────────────────
    "battery": {
        "interval": 15,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% 󰃨",
        "format-plugged": "{capacity}% ",
        "format-alt": "{time} {icon}",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ]
    },
    // ─────────────────────────────────────────────
    // Backlight
    // ─────────────────────────────────────────────
    "backlight": {
        "format": "{percent}% {icon}",
        "format-icons": [
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            ""
        ],
        "min-brightness": 1
    },
    // ─────────────────────────────────────────────
    // Network
    // ─────────────────────────────────────────────
    "network": {
        "format-wifi": "{essid} ({signalStrength}%) ",
        "format-ethernet": "{ipaddr}/{cidr} 󰊗",
        "tooltip-format": "{ifname} via {gwaddr} 󰊗",
        "format-linked": "{ifname} (No IP) 󰊗",
        "format-disconnected": "Disconnected ⚠",
        "format-alt": "{ifname}: {ipaddr}/{cidr}"
    },
    // ─────────────────────────────────────────────
    // Audio
    // ─────────────────────────────────────────────
    // "pulseaudio": {
    //     "format": "{volume}% {icon} {format_source}",
    //     "format-bluetooth": "{volume}% {icon} {format_source}",
    //     "format-bluetooth-muted": "󰅶 {icon} {format_source}",
    //     "format-muted": "󰅶 {format_source}",
    //     "format-source": "{volume}% ",
    //     "format-source-muted": "",
    //     "format-icons": {
    //         "headphone": "",
    //         "hands-free": "󰂑",
    //         "headset": "󰂑",
    //         "phone": "",
    //         "portable": "",
    //         "car": "",
    //         "default": [
    //             "",
    //             "",
    //             ""
    //         ]
    //     },
    //     "on-click": "pavucontrol"
    // },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 mute",
        "format-icons": {
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "on-click": "pavucontrol",
        "scroll-step": 5,
        "_inverted": false
    },
    // ─────────────────────────────────────────────
    // Power profile
    // ─────────────────────────────────────────────
    "custom/power-profile": {
        "exec": "profile=$(powerprofilesctl get); case \"$profile\" in performance) echo ' Performance';; balanced) echo ' Balanced';; power-saver) echo ' Power Saver';; *) echo ' Unknown';; esac",
        "interval": 2,
        "tooltip": true,
        "tooltip-format": "Left click: Balanced\nMiddle click: Performance\nRight click: Power Saver",
        "on-click": "powerprofilesctl set balanced",
        "on-click-middle": "powerprofilesctl set performance",
        "on-click-right": "powerprofilesctl set power-saver"
    },
    // ─────────────────────────────────────────────
    // Tray
    // ─────────────────────────────────────────────
    "tray": {
        "spacing": 10
    },
    // ─────────────────────────────────────────────
    // Clock
    // ─────────────────────────────────────────────
    "clock": {
        "format": "  {:%H:%M}",
        "tooltip-format": "{:%A, %d %B %Y\n%H:%M:%S}",
        "timezone": "Asia/Kolkata",
        "locale": "en_IN.UTF-8",
        "interval": 1,
        "on-click": "",
        "tooltip": true,
        "_inverted": false
    },
    // ─────────────────────────────────────────────
    // Power menu
    // ─────────────────────────────────────────────
    // "custom/power": {
    //     "format": "⏻",
    //     "tooltip": false,
    //     "menu": "on-click",
    //     "menu-file": "$HOME/.config/waybar/power_menu.xml",
    //     "menu-actions": {
    //         // "logout": "exec hyprshutdown",
    //         "shutdown": "shutdown",
    //         "reboot": "reboot",
    //         "suspend": "systemctl suspend",
    //         "hibernate": "systemctl hibernate"
    //     }
    // },
    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-connected": "󰂱 {device_alias}",
        "on-click": "/usr/bin/blueman-manager",
        "interval": 30,
        "tooltip": true,
        "_inverted": false
    },
    // Waybar module
    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "$HOME/.config/waybar/power_menu.xml",
        "menu-actions": {
            "logout": "exec loginctl terminate-user $USER",
            "suspend": "systemctl suspend",
            "hibernate": "systemctl hibernate",
            "shutdown": "systemctl poweroff",
            "reboot": "systemctl reboot"
        }
    },
    "custom/updates": {
        "exec": "count=$(checkupdates 2>/dev/null | wc -l); [ \"$count\" -gt 0 ] && echo '{\"text\":\"󰚰 '\"$count\"'\",\"class\":\"pending\"}' || echo '{\"text\":\"󰚰 0\",\"class\":\"updated\"}'",
        "return-type": "json",
        "interval": 60,
        "tooltip": false,
        "on-click": "alacritty --class floating-terminal --command sudo pacman -Syu",
        "_inverted": false
    },
    // ─────────────────────────────────────────────
    // Groups
    // ─────────────────────────────────────────────
    "group/controls": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 500,
            "children-class": "not-power",
            "transition-left-to-right": false
        },
        "modules": [
            "custom/power-profile",
            "backlight"
        ]
    },
    "group/sysinfo": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 500,
            "children-class": "not-power",
            "transition-left-to-right": false
        },
        "modules": [
            "cpu",
            "memory",
            "disk",
            "battery",
            "temperature"
        ]
    },
    "group/Connect": {
        "orientation": "inherit",
        "modules": [
            "network",
            "bluetooth"
        ],
        "drawer": {
            "transition-duration": 500,
            "children-class": "",
            "transition-left-to-right": false
        }
    }
}