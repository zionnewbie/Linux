// ~/.config/waybar/config
// Generated by configurator.fyi/waybar
// JSONC: comments are allowed here, but not in style.css-adjacent JSON tooling.
// Styling lives in ~/.config/waybar/style.css (see /etc/xdg/waybar/style.css for a default).
{
    "layer": "top",
    "position": "top",
    "height": 35,
    "spacing": 4,
    "modules-left": [
        "clock",
        "hyprland/workspaces",
        "hyprland/submap"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "tray",
        "pulseaudio",
        "network",
        "cpu",
        "memory",
        "disk",
        "battery",
        "backlight",
    ],
    "hyprland/workspaces": {
        "all-outputs": false,
        "format": "{name}"
    },
    "hyprland/window": {
        "max-length": 60
    },
    "hyprland/submap": {
        "format": "<span style=\"italic\">{}</span>"
    },
    "tray": {
        "spacing": 10
    },
    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-muted": "󰝟 muted",
        "format-icons": {
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "on-click": "pavucontrol"
    },
    "network": {
        "format-wifi": "{essid} ({signalStrength}%) ",
        "format-ethernet": "{ipaddr}/{cidr} ",
        "format-disconnected": "disconnected",
        "tooltip": true
    },
    "cpu": {
        "format": "cpu {usage}%",
        "interval": 5
    },
    "memory": {
        "format": "mem {percentage}%",
        "interval": 5
    },
    "disk": {
        "interval": 30,
        "format": "disk {percentage_used}%",
        "path": "/"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% 󰂄",
        "format-icons": [
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾"
        ]
    },
    "backlight": {
        "format": "{percent}% {icon}",
        "format-icons": [
            "󰃞",
            "󰃠"
        ]
    },
    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%Y-%m-%d}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    }
}