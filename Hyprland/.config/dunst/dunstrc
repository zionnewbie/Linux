# ~/.config/dunst/dunstrc
# Generated by configurator.fyi/dunst

[global]
    monitor = 0
    follow = mouse
    width = 300
    height = 300
    origin = top-center
    offset = 10x50
    frame_width = 3
    frame_color = "#7aa2f7"
    font = Monospace 10
    markup = full
    format = "<b>%s</b>\n%b"
    stack_duplicates = true
    progress_bar = true

[urgency_low]
    background = "#16161e"
    foreground = "#c0caf5"
    timeout = 10

[urgency_normal]
    background = "#1a1b26"
    foreground = "#c0caf5"
    timeout = 10

[urgency_critical]
    background = "#f7768e"
    foreground = "#c0caf5"
    frame_color = "#f7768e"
    timeout = 0
